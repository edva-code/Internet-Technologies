<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://example.com/car"
           xmlns:common="http://example.com/dealership-common"
           targetNamespace="http://example.com/car"
           elementFormDefault="qualified">

    <xs:import namespace="http://example.com/dealership-common" schemaLocation="dealership.xsd"/>

    <xs:element name="vehicle" type="carType"/>

    <xs:complexType name="carBaseType">
        <xs:sequence>
            <xs:element name="make" type="xs:string"/>
            <xs:element name="model" type="xs:string"/>
            <xs:element name="year" type="xs:gYear"/>
            <xs:element name="mileage" type="xs:nonNegativeInteger"/>
            <xs:element name="price" type="common:vehiclePriceType"/>
            <xs:element ref="common:engine"/>
            <xs:element ref="common:features" minOccurs="0"/>
            <xs:element name="color" type="xs:string"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:ID" use="required"/>
        <xs:attribute name="arrival-date" type="xs:date" use="required"/>
    </xs:complexType>

    <xs:complexType name="carType">
        <xs:complexContent>
            <xs:extension base="carBaseType">
                <xs:sequence>
                    <xs:element name="doors" type="doorsType"/>
                    <xs:element name="fuel-consumption" type="common:fuelConsumptionType" minOccurs="0"/>
                    <xs:element ref="common:description" minOccurs="0"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:simpleType name="doorsType">
        <xs:restriction base="xs:integer">
            <xs:minInclusive value="2"/>
            <xs:maxInclusive value="5"/>
        </xs:restriction>
    </xs:simpleType>

    <!--
        Restriction principle violation (does not compile):
        <xs:element name="mileage" type="xs:nonNegativeInteger" minOccurs="0"/>
        carBaseType requires mileage, so making it optional would accept a car
        without mileage, which carBaseType rejects. A restriction may only narrow
        its base. Fix: keep mileage required and narrow it instead (fixed="0" below).
    -->
    <xs:complexType name="newCarBaseType">
        <xs:annotation>
            <xs:documentation>A new car: no mileage and features must be listed.</xs:documentation>
        </xs:annotation>
        <xs:complexContent>
            <xs:restriction base="carBaseType">
                <xs:sequence>
                    <xs:element name="make" type="xs:string"/>
                    <xs:element name="model" type="xs:string"/>
                    <xs:element name="year" type="xs:gYear"/>
                    <xs:element name="mileage" type="xs:nonNegativeInteger" fixed="0"/>
                    <xs:element name="price" type="common:vehiclePriceType"/>
                    <xs:element ref="common:engine"/>
                    <xs:element ref="common:features"/>
                    <xs:element name="color" type="xs:string"/>
                </xs:sequence>
            </xs:restriction>
        </xs:complexContent>
    </xs:complexType>

</xs:schema>
